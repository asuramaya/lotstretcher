# Cross-origin isolation. This is not optional.
#
# onnxruntime-web's threaded WASM build needs SharedArrayBuffer, which
# needs crossOriginIsolated, which needs BOTH of these headers. Without
# them ORT does not fail -- it silently drops to a single thread, and a
# vehicle takes ~27s instead of ~12s. A "why is this so slow" bug report
# with no error attached is almost always this.
/*
  Cross-Origin-Opener-Policy: same-origin
  Cross-Origin-Embedder-Policy: require-corp
  X-Content-Type-Options: nosniff
  Referrer-Policy: strict-origin-when-cross-origin
  # No login, no accounts, no analytics, no third-party scripts. The CSP
  # says so in a form a browser will actually enforce.
  #
  # connect-src is deliberately broad: the app fetches vehicle photos
  # from whatever CDN the dealer uses, and (Tier 2, opt-in) talks to an
  # AI provider with the USER's own key. Neither destination is knowable
  # ahead of time. Nothing is sent to lotstretcher.org, because there is
  # no server here to send it to.
  Content-Security-Policy: default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; style-src 'self' 'unsafe-inline'; img-src 'self' blob: data: https:; connect-src 'self' blob: data: https:; worker-src 'self' blob:; media-src 'self' blob:; font-src 'self'; object-src 'none'; base-uri 'none'; form-action 'none'; frame-ancestors 'none'

# The static host's own answer to the app's capability probe (host.js):
# a file, so the CDN says "static" with a 200 instead of logging a 404 on
# every load. The self-hosted server answers from its API route, which is
# registered before its static mount and so shadows this file.
/capabilities
  Content-Type: application/json
  Cache-Control: no-store

# Models are content-addressed by deploy and large. Cache them hard --
# the 44MB matting model should download exactly once per device.
/models/*
  Cache-Control: public, max-age=31536000, immutable

/ort/*
  Cache-Control: public, max-age=31536000, immutable

# Landing and studio media: a day fresh, then served while revalidating.
# Not immutable, because a redeploy may replace a file under the same name.
/demo/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/studio/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/vendor/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800

/icons/*
  Cache-Control: public, max-age=86400, stale-while-revalidate=604800
