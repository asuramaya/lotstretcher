  "browserUnsupported": {
    "$comment": [
      "CLI capabilities a browser cannot do. Listed so the web client can",
      "say WHY something is missing rather than silently omitting it."
    ],
    "upscale": "SwinIR and Real-ESRGAN are far too heavy for a browser tab",
    "wheels": "Wheel money shots need CLIPSeg and SAM2, which have no browser build yet",
    "nvenc": "No GPU encoder access from a page",
    "scraping": "Cross-origin HTML is unreadable, and dealer sites sit behind Cloudflare challenges",
    "inventorySync": "Long-running batch work with no browser equivalent",
    "audio": "The CLI's beat-synced video needs an audio loop and ffmpeg muxing",
    "assets": "Borders and stock backgrounds need an asset library (Tier 1)",
    "scrape": "A browser cannot read another site's page. Use 'From a listing' instead: a bookmarklet run on the vehicle page hands its record and photo links to this app."
  },
  "controls": {
    "$comment": [
      "EVERY composition control, defined ONCE.",
      "",
      "The browser renders its Options pane from this block, and",
      "tests/test_control_parity.py asserts each control's `cli` flag",
      "really exists in cli.py. Adding a control is therefore a single",
      "spec edit plus the CLI flag it names: the UI picks it up with no",
      "JavaScript change, and forgetting the CLI side fails the suite.",
      "",
      "Fields: key (the option name both sides use), type, default,",
      "cli (the flag it maps to), cliInvert (the flag DISABLES it, as",
      "--no-glow does), surfaces (where it applies), requires (a host",
      "capability it needs), unit/min/max/step for ranges.",
      "",
      "A control may be browser-only (surfaces without 'cli'), but ONLY with a cliNote saying why. That keeps the exemption visible instead of letting 'no flag yet' quietly become permanent divergence."
    ],
    "groups": [
      {
        "id": "backdrop",
        "affects": "still",
        "label": "Backdrop",
        "controls": [
          {
            "key": "backdrop",
            "label": "Backdrop",
            "hint": "What sits behind the vehicle",
            "type": "select",
            "presentation": "swatches",
            "default": "vehicle",
            "choices": [
              {
                "value": "vehicle",
                "label": "Vehicle paint",
                "hint": "A gradient from its own colours"
              },
              {
                "value": "generic",
                "label": "Studio",
                "hint": "Seeded hue bands"
              },
              {
                "value": "asset",
                "label": "Stock",
                "hint": "A photo from the studio library",
                "cli": "--photo-background",
                "cliNamed": "--background",
                "expand": "backgrounds",
                "into": "background"
              },
              {
                "value": "custom",
                "label": "Your image",
                "hint": "A photo of your lot or showroom",
                "cli": "--photo-background",
                "file": "customBackground"
              }
            ],
            "cliNote": "The CLI's gradient is always measured from the vehicle's own paint, so only the 'Stock background' choice has a flag; the generated hue bands are a browser-only look."
          },
          {
            "key": "background",
            "label": "Background",
            "hint": "Which stock photo",
            "type": "select",
            "presentation": "hidden",
            "default": null,
            "choices": [],
            "dynamic": "backgrounds",
            "cli": "--background",
            "showWhen": {
              "key": "backdrop",
              "equals": "asset"
            },
            "emptyNote": "Falls back to the library's default photo"
          },
          {
            "key": "customBackground",
            "label": "Your image",
            "hint": "Any photo. It is cover-fitted behind the vehicle and stays on this device",
            "type": "file",
            "presentation": "hidden",
            "default": null,
            "surfaces": [
              "browser"
            ],
            "showWhen": {
              "key": "backdrop",
              "equals": "custom"
            },
            "cliNote": "On the command line the same thing is --photo-background with a path; the browser has no path, so it takes the file itself."
          }
        ]
      },
      {
        "id": "frame",
        "affects": "still",
        "label": "Frame",
        "controls": [
          {
            "key": "border",
            "label": "Frame",
            "hint": "Border artwork around the composition; the vehicle is placed in its window",
            "type": "select",
            "presentation": "swatches",
            "default": "none",
            "choices": [
              {
                "value": "none",
                "label": "No frame",
                "hint": "The backdrop runs to the edge"
              },
              {
                "value": "line",
                "label": "Studio line",
                "hint": "A line the core draws to fit every shape",
                "cli": "--frame-style",
                "cliValue": "line"
              },
              {
                "value": "asset",
                "label": "Stock",
                "hint": "A frame from the studio library",
                "cli": "--frame",
                "cliNamed": "--border",
                "expand": "borders",
                "into": "border"
              },
              {
                "value": "custom",
                "label": "Your frame",
                "hint": "A PNG with a transparent window",
                "file": "customFrame"
              }
            ],
            "cliNote": "No frame has no flag. Studio line is --frame-style line (its colour and weight below). A stock frame is --frame for the library's default or --border NAME for a named one; the app names it. Your own PNG goes to --border as a path, which the file control echoes."
          },
          {
            "key": "customFrame",
            "label": "Your own frame",
            "hint": "A PNG with a transparent window. The vehicle is placed inside it and the frame goes on top, exactly as --border does",
            "type": "file",
            "presentation": "hidden",
            "default": null,
            "surfaces": [
              "browser"
            ],
            "cli": "--border",
            "cliNote": "On the command line the same thing is --border with a path to the PNG; the browser takes the file itself."
          },
          {
            "key": "frameColor",
            "label": "Line colour",
            "hint": "White, black, or the vehicle's own paint",
            "type": "select",
            "default": "white",
            "choices": [
              {
                "value": "white",
                "label": "White"
              },
              {
                "value": "black",
                "label": "Black"
              },
              {
                "value": "paint",
                "label": "Paint"
              }
            ],
            "showWhen": {
              "key": "border",
              "equals": "line"
            },
            "cli": "--frame-color"
          },
          {
            "key": "frameWeight",
            "label": "Line weight",
            "hint": "As a share of the shorter side",
            "type": "range",
            "default": 0.008,
            "min": 0.003,
            "max": 0.03,
            "step": 0.001,
            "unit": "fraction",
            "showWhen": {
              "key": "border",
              "equals": "line"
            },
            "cli": "--frame-weight"
          },
          {
            "key": "frameFit",
            "label": "Frame fit",
            "hint": "How the frame meets a format of another shape. The format always decides the canvas",
            "type": "select",
            "default": "fit",
            "choices": [
              {
                "value": "fit",
                "label": "Fit",
                "hint": "The whole frame, centred; the backdrop fills the rest"
              },
              {
                "value": "fill",
                "label": "Fill",
                "hint": "The frame covers the canvas; its edges are cropped"
              },
              {
                "value": "stretch",
                "label": "Stretch",
                "hint": "The frame is pulled to the canvas shape"
              }
            ],
            "showWhen": {
              "key": "border",
              "notEquals": "none"
            },
            "cli": "--frame-fit"
          },
          {
            "key": "margin",
            "label": "Margin",
            "hint": "Breathing room inside the frame",
            "type": "range",
            "default": 0.06,
            "min": 0.0,
            "max": 0.2,
            "step": 0.01,
            "unit": "fraction",
            "cli": "--margin-frac"
          }
        ]
      },
      {
        "id": "text",
        "affects": "still",
        "label": "Text",
        "controls": [
          {
            "key": "titleMode",
            "label": "Title",
            "hint": "A headline on the still, drawn by the core in the studio font",
            "type": "select",
            "default": "none",
            "choices": [
