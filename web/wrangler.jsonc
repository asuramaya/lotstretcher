{
  // Static files, and one stateless route. Every request is a file except
  // /api/vdp (src/worker.js), which reads a listed dealer's vehicle page
  // from the platform's origin host so a phone can paste an address; it
  // keeps nothing. All computation still happens in the visitor's
  // browser: that is what keeps hosting free and leaves no server-side
  // data to leak.
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "lotstretcher",
  "compatibility_date": "2026-09-22",

  // The site's own name. Custom domains: Cloudflare writes the DNS
  // records itself when it deploys, so nothing is set by hand.
  "workers_dev": true,
  "routes": [
    { "pattern": "lotstretcher.org", "custom_domain": true },
    { "pattern": "www.lotstretcher.org", "custom_domain": true }
  ],

  "main": "src/worker.js",

  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    // Only /api/* reaches the script; every file is served as before.
    "run_worker_first": ["/api/*"],
    // Unknown paths get public/404.html (with a 404 status), which links
    // back to both pages. The app is two real pages, so this mostly
    // catches typos.
    "not_found_handling": "404-page"
  }

  // The 44.2MB matting model does NOT live here. Cloudflare caps static
  // assets at 25 MiB per file on free AND paid plans, so it is served
  // from R2 (zero egress) via MODEL_ORIGIN in js/config.js.
  //
  // "r2_buckets": [{ "binding": "MODELS", "bucket_name": "lotstretcher-models" }]
}
