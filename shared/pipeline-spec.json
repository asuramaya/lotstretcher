  "cutTypes": {
    "$comment": [
      "server/processing.py::CUT_TYPES. 'blur' is accepted by the server",
      "for request-shape compatibility and currently maps to 'complete',",
      "which is a real tracked gap there. browserExposed marks what the",
      "web client offers, so the gap is recorded in one place instead of",
      "being rediscovered."
    ],
    "all": [
      "complete",
      "normal",
      "blur",
      "none"
    ],
    "browserExposed": [
      "complete",
      "none"
    ],
    "notImplemented": [
      "blur"
    ]
  },
  "browserUnsupported": {
    "$comment": [
      "CLI capabilities a browser cannot do. Listed so the web client can",
      "say WHY something is missing rather than silently omitting it."
    ],
    "upscale": "SwinIR and Real-ESRGAN are far too heavy for a browser tab",
    "nvenc": "No GPU encoder access from a page",
    "scraping": "Cross-origin HTML is unreadable, and dealer sites sit behind Cloudflare challenges",
    "inventorySync": "Long-running batch work with no browser equivalent",
    "audio": "The CLI's beat-synced video needs an audio loop and ffmpeg muxing",
    "assets": "Borders and stock backgrounds need an asset library (Tier 1)",
    "scrape": "A browser cannot read another site's page. Use 'From a listing' instead: a bookmarklet run on the vehicle page hands its record and photo links to this app."
  },
  "controls": {
    "$comment": [
      "EVERY composition control, defined ONCE.",
      "",
      "The browser renders its Options pane from this block, and",
      "tests/test_control_parity.py asserts each control's `cli` flag",
      "really exists in cli.py. Adding a control is therefore a single",
      "spec edit plus the CLI flag it names: the UI picks it up with no",
      "JavaScript change, and forgetting the CLI side fails the suite.",
      "",
      "Fields: key (the option name both sides use), type, default,",
      "cli (the flag it maps to), cliInvert (the flag DISABLES it, as",
      "--no-glow does), surfaces (where it applies), requires (a host",
      "capability it needs), unit/min/max/step for ranges.",
      "",
      "A control may be browser-only (surfaces without 'cli'), but ONLY with a cliNote saying why. That keeps the exemption visible instead of letting 'no flag yet' quietly become permanent divergence."
    ],
    "groups": [
      {
        "id": "pipeline",
        "label": "Pipeline",
        "controls": [
          {
            "key": "photoSort",
            "label": "Sort photos",
            "hint": "Separate exteriors, interiors and detail shots",
            "type": "toggle",
            "default": true,
            "cli": "--no-photo-sort",
            "cliInvert": true
          },
          {
            "key": "interiors",
            "label": "Include interiors",
            "hint": "Keep interior shots in the bundle",
            "type": "toggle",
            "default": true,
            "cli": "--no-interiors",
            "cliInvert": true
          },
          {
            "key": "hero",
            "label": "Cut out and compose",
            "hint": "Off means classify only",
            "type": "toggle",
            "default": true,
            "cli": "--no-hero",
            "cliInvert": true
          },
          {
            "key": "strictCutouts",
            "label": "Strict cutouts",
            "hint": "Skip a cutout whose edges came out uncertain",
            "type": "toggle",
            "default": true,
            "cli": "--no-strict-cutouts",
            "cliInvert": true
          },
          {
            "key": "upscale",
            "label": "Upscale cutouts",
            "hint": "SwinIR or Real-ESRGAN on a GPU",
            "type": "toggle",
            "default": false,
            "cli": "--upscale",
            "surfaces": [
              "cli",
              "server"
            ],
            "requires": "upscale"
          }
        ]
      },
      {
        "id": "backdrop",
        "label": "Backdrop",
        "controls": [
          {
            "key": "backdrop",
            "label": "Source",
            "hint": "Where the backdrop comes from",
            "type": "select",
            "default": "vehicle",
            "choices": [
              {
                "value": "vehicle",
                "label": "From the vehicle",
                "hint": "Measured from its own paint"
              },
              {
                "value": "generic",
                "label": "Generated",
                "hint": "Seeded hue bands, no vehicle input"
              },
              {
                "value": "asset",
                "label": "Stock background",
                "hint": "A photo from the asset library",
                "requires": "filesystem",
                "cli": "--photo-background"
              }
            ],
            "cliNote": "The CLI's gradient is always measured from the vehicle's own paint, so only the 'Stock background' choice has a flag; the generated hue bands are a browser-only look."
          },
          {
            "key": "background",
            "label": "Background",
            "hint": "Which stock photo",
            "type": "select",
            "default": null,
            "choices": [],
            "dynamic": "backgrounds",
            "cli": "--background",
            "surfaces": [
              "cli",
              "server"
            ],
            "requires": "filesystem",
            "showWhen": {
              "key": "backdrop",
              "equals": "asset"
            },
            "emptyNote": "Falls back to the library's default photo"
          },
          {
            "key": "spotlight",
            "label": "Spotlight",
            "hint": "Dim the backdrop around the vehicle",
            "type": "toggle",
            "default": true,
            "cli": "--no-spotlight",
            "cliInvert": true
          }
        ]
      },
      {
        "id": "frame",
        "label": "Frame",
        "controls": [
          {
            "key": "frame",
            "label": "Branded frame",
            "hint": "Border artwork around the composition",
            "type": "toggle",
            "default": false,
            "cli": "--frame",
            "surfaces": [
              "cli",
              "server"
            ],
            "requires": "filesystem"
          },
          {
            "key": "border",
            "label": "Border",
            "hint": "Named border from the asset library",
            "type": "select",
            "default": null,
            "choices": [],
            "dynamic": "borders",
            "cli": "--border",
            "surfaces": [
              "cli",
              "server"
            ],
            "requires": "filesystem"
          },
          {
            "key": "margin",
            "label": "Margin",
            "hint": "Breathing room inside the frame",
            "type": "range",
            "default": 0.06,
            "min": 0.0,
            "max": 0.2,
            "step": 0.01,
            "unit": "fraction",
            "cli": "--margin-frac"
          }
        ]
      },
      {
        "id": "glow",
        "label": "Glow",
        "controls": [
          {
            "key": "glow",
            "label": "Glow",
            "hint": "Halo behind the cutout",
            "type": "toggle",
            "default": false,
            "cli": "--no-glow",
            "cliInvert": true
          },
          {
            "key": "glowColor",
            "label": "Colour",
            "hint": "",
            "type": "select",
            "default": "white",
            "choices": [],
            "dynamic": "glowColors",
            "cli": "--glow-color",
            "showWhen": "glow"
          },
          {
            "key": "glowRadius",
            "label": "Radius",
            "hint": "",
            "type": "range",
            "default": 24,
            "min": 4,
            "max": 64,
            "step": 2,
            "unit": "px",
            "cli": "--glow-radius",
            "showWhen": "glow"
          },
          {
            "key": "glowIntensity",
            "label": "Intensity",
            "hint": "",
            "type": "range",
            "default": 0.75,
            "min": 0.1,
            "max": 1.0,
            "step": 0.05,
            "cli": "--glow-intensity",
            "showWhen": "glow"
          }
        ]
      },
      {
        "id": "video",
        "label": "Video",
        "controls": [
          {
            "key": "videoDuration",
            "label": "Length",
            "hint": "How long the clip runs",
            "type": "range",
            "default": 8,
            "min": 3,
            "max": 20,
            "step": 1,
            "unit": "s",
            "cli": "--video-duration"
          },
          {
            "key": "videoFps",
            "label": "Frame rate",
            "hint": "",
            "type": "select",
            "default": 30,
            "choices": [
              {
                "value": 24,
                "label": "24"
              },
              {
                "value": 25,
                "label": "25"
              },
              {
                "value": 30,
                "label": "30"
              }
            ],
            "cli": "--video-fps"
          },
          {
            "key": "videoPush",
            "label": "Push",
            "hint": "How far each shot scales across its dwell",
            "type": "range",
            "default": 0.06,
            "min": 0.0,
            "max": 0.2,
            "step": 0.01,
            "cli": "--video-push",
            "surfaces": [
              "browser"
            ],
            "cliNote": "The CLI's video is beat-synced: shot motion is driven by the audio bar, not by a fixed push. There is no equivalent flag to map to."
          },
          {
            "key": "videoCrossfade",
            "label": "Crossfade",
            "hint": "Seconds of blend between shots",
            "type": "range",
            "default": 0.5,
            "min": 0.0,
            "max": 2.0,
            "step": 0.1,
            "unit": "s",
            "cli": "--video-crossfade",
            "surfaces": [
              "browser"
            ],
            "cliNote": "The CLI transitions on the bar via the conveyor morph (TRANSITION_FRAC), so a crossfade duration has no meaning there."
          },
          {
            "key": "videoMusic",
            "label": "Music",
            "hint": "Beat-synced audio track",
            "type": "toggle",
            "default": false,
            "cli": "--video-music",
            "surfaces": [
              "cli",
              "server"
            ],
            "requires": "filesystem"
          },
          {
            "key": "nvenc",
            "label": "GPU encode",
            "hint": "NVENC hardware encoder",
            "type": "toggle",
            "default": false,
            "cli": "--nvenc",
            "surfaces": [
              "cli",
              "server"
            ],
            "requires": "nvenc"
          },
          {
            "key": "videoFlagBackground",
            "label": "Flag backdrop",
            "hint": "Loop the waving-flag video behind the carousel instead of the gradient",
            "type": "toggle",
            "default": false,
            "cli": "--video-flag-background",
            "surfaces": [
              "cli",
              "server"
            ],
            "requires": "filesystem"
          },
          {
            "key": "videoBpm",
            "label": "Tempo",
            "hint": "Beats per minute the cuts and pulse follow when there is no music",
            "type": "range",
            "default": 100.0,
            "min": 60,
            "max": 160,
            "step": 1,
            "unit": "bpm",
            "cli": "--video-bpm",
            "surfaces": [
              "cli",
              "server"
            ]
          },
          {
            "key": "videoBudgetMb",
            "label": "File size budget",
            "hint": "Bitrate is chosen to fill this many MB; 0 keeps each format's own budget",
            "type": "range",
            "default": 0,
            "min": 0,
            "max": 100,
            "step": 5,
            "unit": "MB",
            "cli": "--video-budget-mb",
            "surfaces": [
              "cli",
              "server"
            ]
          }
        ]
      }
    ]
  },
  "listing": {
    "_": [
      "The subset of a DealerInspire vdp_gtm_payload that scrape.normalize_vehicle reads.",
      "The bookmarklet ships ONLY these keys to the app, so a listing hand-off carries what",
      "the CLI would have used and nothing else. tests/test_listing_parity.py asserts the",
      "list covers every key normalize_vehicle actually touches."
    ],
    "cms": "dealerinspire",
    "analyticsGlobal": "jzlAnalyticsObject",
    "payloadKeys": [
      "boxLength",
      "cabStyle",
      "certifications",
      "conditions_array",
      "dealerComments",
      "dealerDescription",
      "displayPrice",
      "evBatteryRange",
      "evMpgCombined",
      "expando",
      "features",
      "flattened_pricing",
      "location",
      "make",
      "mileage",
      "model",
      "options",
      "price",
      "specifications",
      "stockNumber",
      "tags",
      "trim",
      "used",
      "vehicleStatus",
      "vin",
      "visual",
      "year"
    ],
    "photoUrl": {
      "resizePattern": "/resize/\\d+x\\d+/",
      "target": "/resize/2048x2048/"
    },
    "descriptionMaxChars": 4000,
    "hashParam": "listing",
    "version": 1
  },
  "library": {
    "_": [
      "The on-disk layout of a listings library, as vehicle_pipeline writes it and as both",
      "library readers (server/library.py and web/public/js/library/) read it. One vehicle is",
      "<root>/<bucket>/<folder>/ with details.json beside a bundle/ of finished output.",
      "tests/test_library_parity.py asserts the pipeline writes exactly these names."
    ],
    "buckets": [
      "new",
      "used"
    ],
    "details": "details.json",
    "images": "images",
    "sticker": {
      "pdf": "window-sticker.pdf",
      "json": "window-sticker.json"
    },
    "bundle": {
      "dir": "bundle",
      "hero": "hero.png",
      "heroPortrait": "hero-portrait.png",
      "framed": "framed",
      "interior": "interior",
      "videos": {
        "square": "hero-video.mp4",
        "vertical": "hero-video-vertical.mp4",
        "horizontal": "hero-video-horizontal.mp4"
      },
      "posts": {
        "facebook": "facebook.txt",
        "instagram": "instagram.txt",
        "threads": "threads.txt"
      }
    },
    "rootFiles": {
      "runSummary": "run-summary.json",
      "runs": "runs.jsonl",
      "manifest": "manifest.json"
    }
  }
}
