    "$comment": [
      "compose/hero_video.py. fpsBrowser differs from fps deliberately:",
      "the CLI renders at 25 to match its audio-bar timing, and the",
      "browser has no audio to sync to, so it uses the web-standard 30.",
      "Stated here rather than hidden in one implementation."
    ],
    "fps": 25.0,
    "fpsBrowser": 30,
    "gradientTurns": 1.0,
    "heroMarginFrac": 0.02,
    "accentMarginFrac": 0.03,
    "pulseStrength": 0.035,
    "pulseDecay": 0.3,
    "barsPerLoop": 4,
    "beatsPerBar": 4,
    "transitionFrac": 0.35,
    "minTransitionS": 0.3,
    "maxTransitionS": 0.9,
    "panBars": 2,
    "minPanOverflowFrac": 0.2,
    "panAngleLabel": "side",
    "defaultBpm": 100.0,
    "sizeSafetyFrac": 0.1
